<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Нажатая кнопка -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#0D5FA8" />
            <padding
                android:left="12dp"
                android:top="8dp"
                android:right="12dp"
                android:bottom="6dp" />
        </shape>
    </item>

    <!-- Обычная кнопка -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#2196F3" />
            <padding
                android:left="12dp"
                android:top="6dp"
                android:right="12dp"
                android:bottom="10dp" />
        </shape>
    </item>

</selector>
